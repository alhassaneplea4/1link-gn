# ─────────────────────────────────────────────────────────────────────────────
# 1Link — variables d'environnement.
#   • Développement local : AUCUNE variable n'est nécessaire (`npm run dev` démarre PostgreSQL, l'API et l'interface).
#   • Vercel : à renseigner dans Project Settings → Environment Variables (Production ET Preview).
# Ne JAMAIS committer de valeurs réelles (ce fichier est un modèle).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (obligatoire en production) ───────────────────────────────
# Chaîne de connexion PostgreSQL. Avec Neon : utiliser l'adresse « pooled » (host contenant -pooler) et ?sslmode=require.
DATABASE_URL=postgres://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Connexions simultanées par instance serverless (garder petit : 1 à 5).
DATABASE_POOL_MAX=3

# ── Sécurité (obligatoire en production) ──────────────────────────────────────
# Secret du serveur (HMAC des codes OTP, empreintes de visiteurs). 32 caractères minimum :  openssl rand -base64 48
APP_SECRET=
# URL publique de l'application (liens des e-mails, contrôle d'origine). Vercel la déduit si elle est absente.
APP_URL=https://1link.gn
# Autres origines autorisées à écrire (séparées par des virgules) : domaine personnalisé, etc.
ALLOWED_ORIGINS=
# Secret des tâches planifiées (Vercel l'envoie automatiquement dans Authorization: Bearer …).
CRON_SECRET=

# ── E-mails transactionnels (vérification, réinitialisation) ──────────────────
# resend = envoi réel. Sans fournisseur en production, l'envoi échoue honnêtement (aucun faux succès).
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=1Link <no-reply@votredomaine.com>

# ── Codes WhatsApp / SMS (inscription et connexion par téléphone) ─────────────
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro d'envoi SMS (ou utiliser un Messaging Service)
TWILIO_SMS_FROM=
# Expéditeur WhatsApp approuvé et modèle « Authentication » (obligatoire pour écrire en premier aux utilisateurs)
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_MESSAGING_SERVICE_SID=
# Indicatifs autorisés pour les codes (anti-fraude SMS). Vide = pays proposés par l'application.
OTP_ALLOWED_DIAL_CODES=

# ── Durées et rétention (valeurs par défaut) ──────────────────────────────────
SESSION_DAYS=30
ADMIN_SESSION_HOURS=12
RETENTION_EVENTS_DAYS=400
RETENTION_ERRORS_DAYS=90

# ── Déploiement ───────────────────────────────────────────────────────────────
# 1 = applique les migrations pendant le build Vercel (à réserver à l'environnement Production).
MIGRATE_ON_BUILD=

# ── Interface (variables lues au build, préfixe VITE_) ────────────────────────
# Base de l'API (même origine sur Vercel : /api).
VITE_API_BASE_URL=/api
# Domaine affiché dans les adresses de pages (vide = le domaine servi). Ex. : 1link.gn
VITE_PUBLIC_DOMAIN=
