# Mode des données : "demo" (adaptateurs locaux, clairement signalés) ou "http" (API réelle)
VITE_API_MODE=demo
# URL de base de l'API lorsque VITE_API_MODE=http
VITE_API_BASE_URL=https://api.example.com/v1
# Flux temps réel (SSE) de l'Admin Center, optionnel
VITE_REALTIME_URL=
# Domaine public affiché dans les URL de pages (format définitif à confirmer)
VITE_PUBLIC_DOMAIN=1link.gn
