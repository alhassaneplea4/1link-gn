<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ : aucune donnée de l'application (cookies de session de la WebView, stockage local) n'est incluse
  dans les sauvegardes dans le cloud ni dans les transferts d'appareil à appareil.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
