{
  "name": "1link-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "1Link — Un lien, pour toute votre présence. Front-end de la plateforme.",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local scripts/dev.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "vercel-build": "npm run db:migrate:ci && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:migrate:ci": "tsx scripts/migrate.ts --if-enabled",
    "admin": "tsx --env-file-if-exists=.env.local scripts/admin.ts",
    "test-accounts": "tsx --env-file-if-exists=.env.local scripts/test-accounts.ts",
    "verify:vercel": "tsx scripts/verify-vercel.ts",
    "test:all": "npm run typecheck && npm run test && npm run e2e",
    "mail:test": "tsx --env-file-if-exists=.env.local scripts/mail-test.ts",
    "sms:test": "tsx --env-file-if-exists=.env.local scripts/sms-test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@hono/node-server": "^2.1.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
